# =============================================================================
# Aegis fork — environment reference for the aegis / aisoc / workagent apps and
# the fork's gateway features. Copy what a deployment needs into
# $HERMES_HOME/.env (per profile). Hermes' own variables live in the repo-root
# .env.example; the Jev decision layer is configured under `jev:` in
# config.yaml (see website/docs/user-guide/features/jev-decision-layer.md).
# =============================================================================

# -----------------------------------------------------------------------------
# AISOC (`hermes aisoc`)
# -----------------------------------------------------------------------------
AISOC_JWT_SECRET=
AISOC_MCP_ACTIVE=True
# Set per deployment in $HERMES_HOME/.env.
AISOC_WIKI_PATH=

# -----------------------------------------------------------------------------
# WORKAGENT (`hermes workagent`)
# -----------------------------------------------------------------------------
# Password for the bootstrap `admin` user; ignored once an admin exists.
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=
A2A_BASE_PATH=/a2a
A2A_SESSION_TOKEN=
MESSAGE_DELTA=True
WORKAGENT_A2A_AUTH=False
WORKAGENT_A2A_ADMIN_TOKEN=
WORKAGENT_SESSION_TOKEN=
# Set per deployment in $HERMES_HOME/.env.
WORKAGENT_WIKI_PATH=

USE_ACTIVE_AGENT_PROMPT="<use_agent>{agent_name}</use_agent>"

# -----------------------------------------------------------------------------
# AEGIS WEB OIDC CLIENT (`hermes aegis`) — keep the client secret out of git.
# -----------------------------------------------------------------------------
OIDC_ISSUER=http://127.0.0.1:8080
OIDC_BACKCHANNEL_URL=http://127.0.0.1:8080
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:9130/api/sso/callback
OIDC_POST_LOGIN_REDIRECT=/sso/callback

# Lark SSO
LARK_SSO_ENABLE=false
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=http://127.0.0.1:9130/api/lark/callback

# -----------------------------------------------------------------------------
# AISOC OIDC CLIENT (`hermes aisoc`) — keep the client secret out of git.
# -----------------------------------------------------------------------------
AISOC_OIDC_ISSUER=http://127.0.0.1:8080
AISOC_OIDC_BACKCHANNEL_URL=http://127.0.0.1:8080
AISOC_OIDC_CLIENT_ID=
AISOC_OIDC_CLIENT_SECRET=
AISOC_OIDC_REDIRECT_URI=http://127.0.0.1:9120/api/sso/callback
AISOC_OIDC_POST_LOGIN_REDIRECT=/sso/callback

# -----------------------------------------------------------------------------
# Aegis portal
# -----------------------------------------------------------------------------
AEGIS_PORTAL_URL=http://127.0.0.1:8080
AEGIS_ORG_CODE=
PUBLIC_SUBSCRIPTION_API_KEY=

# -----------------------------------------------------------------------------
# rbac-guard plugin
# -----------------------------------------------------------------------------
AEGIS_RBAC_RULES_PATH=./plugins/rbac-guard/role_rules.json
AEGIS_RBAC_AUDIT=false

# -----------------------------------------------------------------------------
# Feishu / Lark gateway features
# -----------------------------------------------------------------------------
# Reply in a topic under each top-level group/DM message instead of flat.
FEISHU_REPLY_THREAD=true
# Opt-in: render each turn as one CardKit card (title / collapsible execution
# trace / streamed rich text) instead of text+post messages.
FEISHU_CARD_OUTPUT=false
FEISHU_CARD_TITLE="🤖 Hermes"
FEISHU_CARD_DELEGATE_TITLE="🛰️ 委派 · {agent}"
# Files never go inside the card — they arrive as their own messages, and the
# card body keeps this one-line receipt naming them.
FEISHU_CARD_ATTACHMENT_NOTE="📎 已发送文件：{names}"

# Opt-in: prepend the group's recent messages (last N within the last X hours,
# wrapped in <group_messages>) to the first message of a new group session.
FEISHU_GROUP_HISTORY=false
FEISHU_GROUP_HISTORY_LIMIT=20
FEISHU_GROUP_HISTORY_HOURS=24
# Per-message body cap inside the block (0 = no truncation).
FEISHU_GROUP_HISTORY_MSG_MAX_CHARS=1000
# When that first message sits inside a topic, also add this many of the
# topic's own messages as a <thread_messages> block (0 = off).
FEISHU_GROUP_HISTORY_THREAD_LIMIT=20
# How history is fetched: "api" (lark SDK, default) or "cli" (runs
# `lark-cli im +chat-messages-list` / `+threads-messages-list` as the bot).
FEISHU_GROUP_HISTORY_SOURCE=api
# lark-cli executable for the cli source (name on PATH or absolute path).
FEISHU_GROUP_HISTORY_CLI_BIN=lark-cli
# Which regions of an interactive card enter the block: any of title, trace
# (the collapsible execution-trace panel), body (the final answer), or all.
FEISHU_GROUP_HISTORY_CARD_REGIONS=title,body

# -----------------------------------------------------------------------------
# aegis_a2a_delegate
# -----------------------------------------------------------------------------
A2A_POLL_INTERVAL=3
A2A_POLL_TIMEOUT=300

# -----------------------------------------------------------------------------
# Jev (TypeSafe System One) — secrets only; settings live under `jev:` in
# config.yaml. HERMES_JEV_* / TYPESAFE_MODEL also work as per-deployment
# overrides (see the Jev docs page for the full list).
# -----------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
